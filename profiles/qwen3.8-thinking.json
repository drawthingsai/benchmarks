{
  "schema_version": 1,
  "suite": {
    "id": "qwen3.8-thinking-v2",
    "title": "Qwen3.8 reasoning, instruction, and function-calling suite",
    "description": "A reproducible public profile using Qwen3.8 official thinking-mode sampling and the default xhigh reasoning effort."
  },
  "generation": {
    "temperature": 1.0,
    "top_p": 0.95,
    "top_k": 20,
    "max_tokens": 262144,
    "timeout": 21600,
    "extra_body": {
      "min_p": 0.0,
      "presence_penalty": 0.0,
      "repeat_penalty": 1.0,
      "chat_template_kwargs": {"enable_thinking": true, "reasoning_effort": "xhigh"}
    }
  },
  "evalscope": {"seed": 42, "eval_batch_size": 1, "dataset_hub": "modelscope", "collect_perf": true},
  "cases": [
    {
      "id": "gpqa-diamond", "dataset": "gpqa_diamond", "expected_samples": 198,
      "dataset_args": {"eval_split": "train", "shuffle": false},
      "primary_metric": {"name": "mean_acc", "direction": "higher", "scale": "fraction"}
    },
    {
      "id": "aime-2026", "dataset": "aime26", "expected_samples": 30,
      "dataset_args": {"eval_split": "test", "shuffle": false},
      "primary_metric": {"name": "mean_acc", "direction": "higher", "scale": "fraction"}
    },
    {
      "id": "ifeval", "dataset": "ifeval", "expected_samples": 541,
      "dataset_args": {"eval_split": "train", "shuffle": false},
      "primary_metric": {"name": "mean_prompt_level_strict", "direction": "higher", "scale": "fraction"}
    },
    {
      "id": "bfcl-v3-quick", "dataset": "bfcl_v3", "expected_samples": 100, "limit": 10,
      "dataset_args": {
        "subset_list": [
          "simple", "java", "javascript", "multiple", "parallel", "parallel_multiple",
          "irrelevance", "live_simple", "live_multiple", "live_parallel"
        ],
        "extra_params": {"is_fc_model": true}
      },
      "generation": {"max_tokens": 10000},
      "primary_metric": {"name": "acc", "direction": "higher", "scale": "fraction"}
    },
    {
      "id": "bfcl-v4-quick", "dataset": "bfcl_v4", "expected_samples": 100, "limit": 10,
      "dataset_args": {
        "subset_list": [
          "simple_python", "simple_java", "simple_javascript", "multiple", "parallel",
          "parallel_multiple", "irrelevance", "live_simple", "live_multiple", "live_parallel"
        ],
        "extra_params": {"is_fc_model": true}
      },
      "generation": {"max_tokens": 10000},
      "primary_metric": {"name": "acc", "direction": "higher", "scale": "fraction"}
    }
  ]
}
